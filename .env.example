# Copy to .env, then chmod 600 .env. Never commit credentials.
# Create a personal customer client at https://developer.sparebank1.no/
SB1_CLIENT_ID=replace-with-your-client-id
SB1_CLIENT_SECRET=replace-with-your-client-secret
# Must exactly match a redirect URI registered with that client.
# If the portal requires HTTPS, register https://localhost and use login --manual.
SB1_REDIRECT_URI=http://127.0.0.1:8765/callback
# Optional bank identifier; omitted opens the bank picker.
# SB1_FIN_INST=

# Optional absolute path. Default: ~/.config/sparebank1-mcp/tokens.json
# SB1_TOKEN_FILE=/absolute/private/path/tokens.json

# Alternative to managed login: an existing short-lived bearer token.
# When set, this overrides the token file and disables automatic refresh.
# SB1_ACCESS_TOKEN=

# Money movement is opt-in. Restart the MCP client after changing these.
SB1_ENABLE_TRANSFERS=false
# Local per-transfer limit in source-account currency, at most two decimals.
SB1_MAX_TRANSFER_AMOUNT=10000.00
SB1_REQUEST_TIMEOUT_MS=15000
